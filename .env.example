# GST Verification Service Configuration

# Port to listen on (Default: 5001)
PORT=5001
HOST=0.0.0.0

# Environment: development / production
ENVIRONMENT=development

# Optional API Key for authenticating clients (Leave blank to disable)
# API_KEY=your_secure_random_key_here

# Captcha Session TTL in seconds (Default: 300 = 5 minutes)
SESSION_TTL_SECONDS=300

# Cleanup interval for expired sessions in seconds (Default: 60)
SESSION_CLEANUP_INTERVAL_SECONDS=60

# GST Portal HTTP Timeout in seconds (Default: 12)
GST_PORTAL_TIMEOUT_SECONDS=12

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*
